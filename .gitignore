
# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Packaging and build output
build/
dist/
*.egg-info/
.eggs/

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local databases and logs
*.sqlite
*.sqlite3
*.db
*.log

# Research data and model artifacts
data/raw/
data/processed/
datasets/
artifacts/
checkpoints/
models/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# Experiment outputs
mlruns/
wandb/
outputs/
/runs/

# Local secrets and cloud credentials
secrets/
credentials/
.modal/

# Frontend generated output
node_modules/
frontend/test-results/
frontend/playwright-report/
frontend/playwright/.auth/

# Gold-set PDFs are local-only (licensed papers, never committed)
tests/gold/papers/*
!tests/gold/papers/.gitkeep

# User-supplied paper corpus and eval draft cache (never committed)
research_papers/
tests/gold/.cache/

# Parallel-phase git worktrees (scratch checkouts, never committed)
.worktrees/
