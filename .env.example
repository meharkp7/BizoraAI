
# Application
BIZORA_APP_NAME=Bizora
BIZORA_ENVIRONMENT=development
BIZORA_LOG_LEVEL=INFO
BIZORA_API_PREFIX=/api/v1

# Security
# Generate a unique random value for local use. Never use this example in production.
BIZORA_SECRET_KEY=replace-with-a-random-secret-before-running

# Database (canonical; used by both the app and Alembic migrations)
BIZORA_DATABASE_URL=postgresql+psycopg://bizora:bizora@localhost:5432/bizora
# Legacy process-env override: DATABASE_URL applies only when
# BIZORA_DATABASE_URL is unset. Prefer BIZORA_DATABASE_URL.

# Meta / Muse API
META_API_KEY=
MUSE_MODEL_API_BASE_URL=
MUSE_MODEL_NAME=

# Fireworks AI
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL_NAME=

# Baseten — optional persistent model serving
BASETEN_API_KEY=
BASETEN_MODEL_URL=

# Modal — optional isolated experiment execution
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=bizora-experiments

# Experiment safety limits
BIZORA_MAX_UPLOAD_MB=50
BIZORA_MAX_EXPERIMENT_MINUTES=60
BIZORA_MAX_CONCURRENT_EXPERIMENTS=2

# External integrations are disabled until explicitly configured
BIZORA_ENABLE_FIREWORKS=false
BIZORA_ENABLE_BASETEN=false
BIZORA_ENABLE_MODAL=false

# First-run sample paper (defaults to the stable SRAM PUF identifiers)
BIZORA_SAMPLE_PAPER_PROJECT_ID=a-2-bit-cell-tilting-sram-based-puf-with-4c144156
BIZORA_SAMPLE_PAPER_GRAPH_ID=a-2-bit-cell-tilting-sram-based-puf-with-graph-4c144156
BIZORA_SAMPLE_PAPER_SOURCE_ID=paper-4c144156
BIZORA_SAMPLE_PAPER_TITLE=A 2-Bit Cell Tilting SRAM-Based PUF With a BER of 3.1E-10 and an Energy of 21 fJ/Bit in 65nm

# Extraction-quality dashboard (eval report locations; rarely overridden)
BIZORA_DIAGRAM_EVAL_DIR=docs/visual-eval
BIZORA_COPILOT_EVAL_RESULTS=tests/copilot_eval/.cache/results/latest.json

# Spend visibility (estimated rates) and server-enforced caps (0 disables a cap)
BIZORA_USD_PER_1K_INPUT=0.003
BIZORA_USD_PER_1K_OUTPUT=0.015
BIZORA_DAILY_SPEND_CAP_USD=25.0
BIZORA_RUN_SPEND_CAP_USD=5.0
BIZORA_MAX_RUNS_PER_DAY=50
